<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MathMilo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
    </style>

    <!-- Launch screen: matches the island icon; dismissed on first frame (no artificial delay). -->
    <style name="Theme.MathMilo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MathMilo</item>
    </style>
</resources>
